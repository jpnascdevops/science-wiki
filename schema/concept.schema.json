{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "recap",
    "levels",
    "consensus",
    "tags",
    "equations",
    "claims",
    "resources",
    "review"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "zero",
          "intermediate",
          "technical"
        ]
      }
    },
    "tags": {
      "type": "object",
      "required": [
        "area",
        "topics"
      ],
      "additionalProperties": false,
      "properties": {
        "area": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "era": {
          "type": "string"
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "arxiv_category": {
          "type": "string"
        },
        "wikidata": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q[0-9]+$"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "equations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tex",
          "spoken"
        ],
        "additionalProperties": false,
        "properties": {
          "tex": {
            "type": "string"
          },
          "spoken": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "type",
          "check",
          "status",
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "type": {
            "enum": [
              "number",
              "date",
              "attribution",
              "definition",
              "conceptual",
              "reference"
            ]
          },
          "check": {
            "enum": [
              "compute",
              "source",
              "arxiv",
              "verifier",
              "human"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "verified",
              "disputed",
              "wrong",
              "calculated",
              "reference_checked"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "formula": {
            "type": "string"
          },
          "expected": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "tolerance": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.1
          },
          "arxiv": {
            "type": "string"
          },
          "expected_title": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "reviewed_by": {
            "type": "string"
          },
          "consensus": {
            "enum": [
              "established",
              "broad",
              "debated",
              "speculative",
              "superseded"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "absolute_tolerance": {
            "type": "number",
            "minimum": 0
          },
          "covers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "definition",
                "equation",
                "recap"
              ]
            }
          },
          "assumptions": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "locator",
              "support",
              "checked_at",
              "claim_hash",
              "content_hash"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "support": {
                "type": "string",
                "minLength": 1
              },
              "checked_at": {
                "type": "string",
                "minLength": 1
              },
              "claim_hash": {
                "type": "string",
                "minLength": 1
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "level",
          "lang"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "watch",
              "read",
              "study"
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "level": {
            "enum": [
              "zero",
              "intermediate",
              "technical"
            ]
          },
          "lang": {
            "enum": [
              "pt",
              "en",
              "es"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "auto_checked",
            "human_reviewed"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "recap": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "consensus": {
      "enum": [
        "established",
        "broad",
        "debated",
        "speculative",
        "superseded"
      ]
    }
  }
}
